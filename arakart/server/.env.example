# Environment & Port
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/arakart

# JWT Secrets
JWT_SECRET=super_secret_jwt_access_token_key_at_least_64_characters_long_for_security_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_at_least_64_characters_long_for_security_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Delivery Adapters (console | msg91 / smtp)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AraKart <no-reply@arakart.local>

# OAuth & Development Toggles
GOOGLE_CLIENT_ID=
CODE_DEV_ECHO=true

# Initial Admin Credentials (for seed script)
SEED_ADMIN_NAME=AraKart Admin
SEED_ADMIN_EMAIL=admin@arakart.local
SEED_ADMIN_PHONE=9999999999

# CORS
CORS_ORIGIN=http://localhost:5173
